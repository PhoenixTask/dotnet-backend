{
  "ConnectionStrings": {
    "Database": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  },
  "FrontEnd": {
    "Addresses": [
      "https://phoenix-task-three.vercel.app",
      "http://localhost:3000",
      "https://phoenix-task-nedamani-official.vercel.app"
    ]
  },
  "Mail": {
    "SenderDisplayName": "PhoenixTask",
    "SenderEmail": "",
    "SmtpPassword": "",
    "SmtpServer": "",
    "SmtpPort": 0
  },
  "Google": {
    "ClientId": ""
  }
}
